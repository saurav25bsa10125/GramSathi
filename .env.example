# =================================================================
# GramSathi — Solar-Powered Smart Village Hub & Rural Digital Platform
# Environment Configuration Template
# =================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (e.g. `copy .env.example .env` or `cp .env.example .env`)
# 2. Replace the placeholder values with your real API credentials
# 3. NEVER commit .env to source control (it is protected by .gitignore)
# 4. NEVER expose secret keys to frontend JavaScript
# =================================================================

# Server Port
PORT=3000

# Groq Cloud API Integration (PRIMARY AI ENGINE for GramSathi Assistant & Explanations)
# Supports ultra-fast inference with Llama 3.3 / Llama 3.1
GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Integration (Secondary Backup Fallback Engine)
OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Weather API (Optional - OpenWeatherMap / WeatherAPI; falls back to free live Open-Meteo satellite feed)
WEATHER_API_KEY=e5be6e7070a62f879956ca8ed1469cac

# Mandi & Agricultural Market API (Optional - Agmarknet / e-NAM / data.gov.in)
MANDI_API_KEY=579b464db66ec23bdd000001afa5d43f082d455d413f867b4e51ed92

# Government Schemes API (Optional - myScheme / data.gov.in official portal)
GOVT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Voice & Speech Service API (Optional - browser Web Speech API used by default)
VOICE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Cellular Gateway API (Optional - for real GSM/SMS delivery; simulated gateway active by default)
SMS_API_KEY=0MVGuQZC5kB2HtN7saAvzegJSjKYfWi4obF3X1UhnLDPERIycTx2pLG5oNWJjKt6Ul0vemInMdTVFf3S

# Default Village Hub Location
DEFAULT_VILLAGE_NAME=Rampur Village Hub
DEFAULT_VILLAGE_STATE=Uttar Pradesh
DEFAULT_VILLAGE_LAT=25.5941
DEFAULT_VILLAGE_LON=85.1376